_commit=38a5d60cf549fcead9a8880a4831b852ab95b92d
pkgver=r640.38a5d60c
pkgrel=2
pkgdesc="linux-wallpaperengine con los arreglos de RipoWall (personajes puppet de Wallpaper Engine)"
arch=('x86_64')
url="https://github.com/Almamu/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'freeglut' 'libpulse' 'libcups' 'at-spi2-core' 'nss' 'libxcomposite' 'libxdamage' 'nspr')
makedepends=('git' 'cmake' 'sdl2' 'glm' 'wayland-protocols' 'xorg-xrandr')
provides=("linux-wallpaperengine=${pkgver}")
conflicts=('linux-wallpaperengine' 'linux-wallpaperengine-git')
source=("${_pkgname}::git+https://github.com/Almamu/linux-wallpaperengine.git#commit=${_commit}"
        '0001-puppet-warp.patch'
