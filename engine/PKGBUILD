# Motor de escenas de RipoWall: linux-wallpaperengine de upstream en un commit fijo, con los parches de
# engine/patches/ (personajes "puppet", shaders, encuadre y efectos; ver engine/README.md).
# Reemplaza a linux-wallpaperengine / linux-wallpaperengine-git mientras los parches no estén en upstream.
# No se construye desde esta carpeta: engine/instalar-motor.sh copia este archivo y los parches a una carpeta
# de trabajo (makepkg busca las fuentes locales junto al PKGBUILD) y corre makepkg ahí.
pkgname=linux-wallpaperengine-ripowall
_pkgname=linux-wallpaperengine
_commit=38a5d60cf549fcead9a8880a4831b852ab95b92d
pkgver=r640.38a5d60c
pkgrel=2
pkgdesc="linux-wallpaperengine con los arreglos de RipoWall (personajes puppet de Wallpaper Engine)"
arch=('x86_64')
url="https://github.com/Almamu/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'freeglut' 'libpulse' 'libcups' 'at-spi2-core' 'nss' 'libxcomposite' 'libxdamage' 'nspr')
makedepends=('git' 'cmake' 'sdl2' 'glm' 'wayland-protocols' 'xorg-xrandr')
provides=("linux-wallpaperengine=${pkgver}")
conflicts=('linux-wallpaperengine' 'linux-wallpaperengine-git')
source=("${_pkgname}::git+https://github.com/Almamu/linux-wallpaperengine.git#commit=${_commit}"
        '0001-puppet-warp.patch'
        '0002-uniform-types.patch'
