diff --git a/src/WallpaperEngine/Render/Wallpapers/AutoProjection.cpp b/src/WallpaperEngine/Render/Wallpapers/AutoProjection.cpp
new file mode 100644
index 00000000..60db8b65
--- /dev/null
+++ b/src/WallpaperEngine/Render/Wallpapers/AutoProjection.cpp
@@ -0,0 +1,16 @@
+#include "AutoProjection.h"
+
+#include <glm/common.hpp>
+
+glm::vec2 WallpaperEngine::Render::Wallpapers::autoProjectionSize (const std::vector<AutoProjectionImage>& images) {
+    glm::vec2 extent (0.0f);
+
+    for (const auto& image : images) {
+	if (image.size.x <= 0.0f || image.size.y <= 0.0f) {
+	    continue;
+	}
+	extent = glm::max (extent, glm::vec2 (image.origin) + image.size / 2.0f);
+    }
+
+    return extent;
+}
diff --git a/src/WallpaperEngine/Render/Wallpapers/AutoProjection.h b/src/WallpaperEngine/Render/Wallpapers/AutoProjection.h
new file mode 100644
index 00000000..dbd4d231
--- /dev/null
+++ b/src/WallpaperEngine/Render/Wallpapers/AutoProjection.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <vector>
+
+#include <glm/vec2.hpp>
+#include <glm/vec3.hpp>
+
+namespace WallpaperEngine::Render::Wallpapers {
+struct AutoProjectionImage {
+    /** Center of the image in scene coordinates (0, 0 is the bottom left corner of the scene) */
+    glm::vec3 origin;
+    glm::vec2 size;
+};
+
+/**
+ * Size of a scene whose orthogonal projection is "auto" and doesn't say its width and height: scene coordinates
+ * start at 0, so the scene ends where the farthest image does
+ *
+ * @return The size, or 0x0 when there are no images to measure
+ */
+glm::vec2 autoProjectionSize (const std::vector<AutoProjectionImage>& images);
+} // namespace WallpaperEngine::Render::Wallpapers
