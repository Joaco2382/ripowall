@@ -120,6 +120,33 @@ public:
      */
     [[nodiscard]] static std::string narrowFragmentVaryings (std::string fragment, const std::string& vertex);
 
+    /**
+     * HLSL lets a shader modify its inputs (they're parameters of the entry point), GLSL doesn't. Every varying the
+     * fragment shader writes to gets a writable global copy, filled with the input at the start of main, and a
+     * macro of the same name sends every use to the copy
+     *
+     * @param fragment The fragment shader's source
+     *
+     * @return The fragment source with writable copies of the varyings it modifies
+     */
+    [[nodiscard]] static std::string makeFragmentInputsWritable (std::string fragment);
+
+    /**
+     * Wallpaper Engine shares every vertex output with the fragment shader, so a fragment shader can read a varying
+     * it never declares. Declares, before main, every vertex varying the fragment uses without declaring it
+     *
+     * @param fragment The fragment shader's source
+     * @param vertex The vertex shader's source
+     *
+     * @return The fragment source with the missing declarations
+     */
+    [[nodiscard]] static std::string declareMissingFragmentVaryings (std::string fragment, const std::string& vertex);
+
+    /**
+     * Parses the JSON metadata of a shader parameter, also accepting numbers written with leading zeros
+     */
+    [[nodiscard]] static JSON parseLenientJson (const std::string& content);
+
 private:
     /**
      * Parses a COMBO value to add the proper define to the code
diff --git a/src/WallpaperEngine/Testing/Cases/HlslShapes.cpp b/src/WallpaperEngine/Testing/Cases/HlslShapes.cpp
new file mode 100644
index 00000000..0cf451b9
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/HlslShapes.cpp
@@ -0,0 +1,47 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "WallpaperEngine/Render/Shaders/GLSLContext.h"
+
+using WallpaperEngine::Render::Shaders::GLSLContext;
+
+namespace {
+const std::string vertex = "#version 330\n"
+			   "in vec3 a_Position;\n"
+			   "out vec2 v_Scroll;\n"
+			   "void main () { v_Scroll = a_Position.xy; gl_Position = vec4 (a_Position, 1.0); }\n";
+}
+
+// Wallpaper Engine compiles its GLSL shaders with HLSL rules: mixing vector sizes truncates the larger one
+TEST_CASE ("Vectors of different sizes in arithmetic are truncated to the smaller one") {
+    const std::string fragment = "#version 330\n"
+				 "in vec2 v_Scroll;\n"
+				 "out vec4 color;\n"
+				 "void main () { vec3 refract = vec3 (1.0); vec2 sum = (refract + v_Scroll) * 2.0;"
+				 " color = vec4 (sum, 0.0, 1.0); }\n";
+
+    const auto [vertexGlsl, fragmentGlsl] = GLSLContext::get ().toGlsl (vertex, fragment);
+    REQUIRE_FALSE (fragmentGlsl.empty ());
+}
+
+// already handled by the glslang fork before the arithmetic case, kept as a regression check
+TEST_CASE ("A wider vector assigned to a narrower one is truncated") {
+    const std::string fragment = "#version 330\n"
+				 "in vec2 v_Scroll;\n"
+				 "out vec4 color;\n"
+				 "void main () { vec2 position = vec4 (v_Scroll, 0.0, 1.0); position += vec3 (1.0);"
+				 " color = vec4 (position, 0.0, 1.0); }\n";
+
+    const auto [vertexGlsl, fragmentGlsl] = GLSLContext::get ().toGlsl (vertex, fragment);
+    REQUIRE_FALSE (fragmentGlsl.empty ());
+}
+
+TEST_CASE ("Valid GLSL still rejects what HLSL rejects too") {
+    // a narrower vector can't become a wider one in either language
+    const std::string fragment = "#version 330\n"
+				 "in vec2 v_Scroll;\n"
+				 "out vec4 color;\n"
+				 "void main () { vec4 wide = v_Scroll; color = wide; }\n";
+
+    const auto [vertexGlsl, fragmentGlsl] = GLSLContext::get ().toGlsl (vertex, fragment);
+    CHECK (fragmentGlsl.empty ());
+}
diff --git a/src/WallpaperEngine/Testing/Cases/ShaderVaryings.cpp b/src/WallpaperEngine/Testing/Cases/ShaderVaryings.cpp
index 1e0aad3c..bcc596ef 100644
--- a/src/WallpaperEngine/Testing/Cases/ShaderVaryings.cpp
+++ b/src/WallpaperEngine/Testing/Cases/ShaderVaryings.cpp
@@ -37,3 +37,49 @@ TEST_CASE ("Without anything to change the fragment comes back as it was") {
     const std::string fragment = "uniform vec4 g_Color;\nvoid main () {}\n";
     CHECK (ShaderUnit::narrowFragmentVaryings (fragment, "varying vec4 v_TexCoord;\n") == fragment);
 }
+
+// workshop 2405891694: "v_RefractTexCoord.xy = frac((v_RefractTexCoord + v_Scroll) * g_Scale);" writes to a vec3
+// input and adds a vec3 and a vec2, both valid with the HLSL rules Wallpaper Engine compiles with
+TEST_CASE ("Varyings the fragment shader writes to get a writable copy filled from the input") {
+    const std::string fragment
+	= "varying vec3 v_Refract;\nvarying vec2 v_Scroll;\n"
+	  "void main() {\n\tv_Refract.xy = v_Refract.xy + v_Scroll;\n\tgl_FragColor = vec4 (v_Refract, 1.0);\n}\n";
+
+    const std::string result = ShaderUnit::makeFragmentInputsWritable (fragment);
+
+    CHECK (result.find ("vec3 ripowall_writable_v_Refract;") != std::string::npos);
+    CHECK (result.find ("ripowall_writable_v_Refract = v_Refract;") != std::string::npos);
+    CHECK (result.find ("#define v_Refract ripowall_writable_v_Refract") != std::string::npos);
+    // a varying that is only read keeps being the input
+    CHECK (result.find ("ripowall_writable_v_Scroll") == std::string::npos);
+    // the copy is filled at the start of main, before the body runs
+    CHECK (result.find ("ripowall_writable_v_Refract = v_Refract;") < result.find ("v_Refract.xy = v_Refract.xy"));
+    // comparisons are not writes
+    CHECK (
+	ShaderUnit::makeFragmentInputsWritable (
+	    "varying float v_A;\nvoid main() { if (v_A == 1.0 || v_A >= 2.0) {} }\n"
+	)
+	    .find ("ripowall_writable")
+	== std::string::npos
+    );
+}
+
+// workshop 2169779628: foliagesway.frag reads v_Bounds, which only foliagesway.vert declares
+TEST_CASE ("Vertex varyings the fragment reads without declaring them are declared") {
+    const std::string vertex = "varying vec4 v_TexCoord;\nvarying vec2 v_Bounds;\nvarying vec3 v_Unused;\n";
+    const std::string fragment = "varying vec4 v_TexCoord;\nvoid main() { float x = v_Bounds.x; }\n";
+
+    const std::string result = ShaderUnit::declareMissingFragmentVaryings (fragment, vertex);
+
+    CHECK (result.find ("varying vec2 v_Bounds;\nvoid main()") != std::string::npos);
+    CHECK (result.find ("v_Unused") == std::string::npos);
+    // already declared: not declared twice
+    CHECK (result.find ("varying vec4 v_TexCoord;") == result.rfind ("varying vec4 v_TexCoord;"));
+}
+
+TEST_CASE ("Parameter metadata with leading zeros in numbers is still read") {
+    const auto data = ShaderUnit::parseLenientJson (R"({"material":"Speed","default":1,"range":[0,01]})");
+    CHECK (data["default"].get<int> () == 1);
+    CHECK (data["range"][1].get<int> () == 1);
+    CHECK_THROWS (ShaderUnit::parseLenientJson ("{not json"));
+}
