 }
 
+JSON ShaderUnit::parseLenientJson (const std::string& content) {
+    try {
+	return JSON::parse (content);
+    } catch (const std::exception&) {
+	// numbers written with leading zeros ("range":[0,01]) are fine for the editor but not valid JSON
+	static const std::regex leadingZeros (R"(([\[,:\s-])0+([0-9]))");
+	const std::string fixed = std::regex_replace (content, leadingZeros, "$1$2");
+	if (fixed == content) {
+	    throw;
+	}
+	return JSON::parse (fixed);
+    }
+}
+
+std::string ShaderUnit::declareMissingFragmentVaryings (std::string fragment, const std::string& vertex) {
+    static const std::regex declaration (R"(\bvarying\s+(float|vec2|vec3|vec4)\s+([A-Za-z_][A-Za-z0-9_]*)\s*;)");
+    static const std::regex mainStart (R"(\bvoid\s+main\s*\()");
+
+    std::smatch main;
+    if (!std::regex_search (fragment, main, mainStart)) {
+	return fragment;
+    }
+
+    std::string declarations;
+    for (auto it = std::sregex_iterator (vertex.begin (), vertex.end (), declaration); it != std::sregex_iterator ();
+	 ++it) {
+	const std::string name = (*it)[2].str ();
+	const std::regex used ("\\b" + name + "\\b");
+	const std::regex declared (R"(\bvarying\s+\w+\s+)" + name + "\\b");
+	if (std::regex_search (fragment, used) && !std::regex_search (fragment, declared)
+	    && declarations.find (" " + name + ";") == std::string::npos) {
+	    declarations += "varying " + (*it)[1].str () + " " + name + ";\n";
+	}
+    }
+
+    if (!declarations.empty ()) {
+	fragment.insert (main.position (), declarations);
+    }
+    return fragment;
+}
+
+std::string ShaderUnit::makeFragmentInputsWritable (std::string fragment) {
+    static const std::regex declaration (R"(\bvarying\s+(float|vec2|vec3|vec4)\s+([A-Za-z_][A-Za-z0-9_]*)\s*;)");
+    static const std::regex mainStart (R"(\bvoid\s+main\s*\(\s*(void)?\s*\)\s*\{)");
+
+    struct Input {
+	std::string type;
+	std::string name;
+	size_t end;
+    };
+    std::vector<Input> written;
+    for (auto it = std::sregex_iterator (fragment.begin (), fragment.end (), declaration);
+	 it != std::sregex_iterator (); ++it) {
+	const std::string name = (*it)[2].str ();
+	// an assignment (plain or compound, to the whole value or to some components) or an increment
+	const std::regex write (
+	    "\\b" + name + R"(\b(\s*\.\s*[xyzwrgba]+)?\s*(([-+*/]?=(?!=))|\+\+|--))" + "|" + R"((\+\+|--)\s*)" + name
+	    + "\\b"
+	);
+	if (std::regex_search (fragment.cbegin () + it->position () + it->length (), fragment.cend (), write)) {
+	    written.push_back ({ (*it)[1].str (), name, static_cast<size_t> (it->position () + it->length ()) });
+	}
+    }
+
+    std::smatch main;
+    if (written.empty () || !std::regex_search (fragment, main, mainStart)) {
+	return fragment;
+    }
+
+    // the copies are filled first thing in main, reading the real inputs
+    std::string initialization = "\n";
+    for (const auto& input : written) {
+	initialization += "#undef " + input.name + "\nripowall_writable_" + input.name + " = " + input.name
+	    + ";\n#define " + input.name + " ripowall_writable_" + input.name + "\n";
+    }
+    fragment.insert (main.position () + main.length (), initialization);
+
+    // declarations from the last one so the offsets stay valid
+    for (auto input = written.rbegin (); input != written.rend (); ++input) {
+	// the #undef also drops a truncating macro narrowFragmentVaryings may add for the same name
+	fragment.insert (
+	    input->end,
+	    "\n" + input->type + " ripowall_writable_" + input->name + ";\n#undef " + input->name + "\n#define "
+		+ input->name + " ripowall_writable_" + input->name + "\n"
+	);
+    }
+
+    return fragment;
+}
+
 std::string ShaderUnit::applyFragmentTexCoordCompatibility (std::string source) const {
     if (this->m_type != GLSLContext::UnitType_Fragment) {
 	return source;
@@ -517,7 +607,7 @@ void ShaderUnit::parseParameterConfiguration (
 ) {
     JSON data;
     try {
-	data = JSON::parse (content);
+	data = parseLenientJson (content);
     } catch (const std::exception& e) {
 	sLog.error ("Cannot parse parameter metadata for ", name, " in shader ", this->m_file, ": ", e.what ());
 	return;
@@ -748,8 +838,14 @@ const std::string& ShaderUnit::compile () {
 
     // this should be the rest of the shader
     std::string body = this->applyLinkedVaryingCompatibility (this->m_preprocessed);
-    if (this->m_type == GLSLContext::UnitType_Fragment && this->m_link != nullptr) {
-	body = narrowFragmentVaryings (std::move (body), this->m_link->m_preprocessed);
+    if (this->m_type == GLSLContext::UnitType_Fragment) {
+	if (this->m_link != nullptr) {
+	    body = declareMissingFragmentVaryings (std::move (body), this->m_link->m_preprocessed);
+	}
+	body = makeFragmentInputsWritable (std::move (body));
+	if (this->m_link != nullptr) {
+	    body = narrowFragmentVaryings (std::move (body), this->m_link->m_preprocessed);
+	}
     }
     this->m_final += this->applyFragmentTexCoordCompatibility (std::move (body));
 
