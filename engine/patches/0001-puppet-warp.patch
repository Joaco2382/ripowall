diff --git a/src/WallpaperEngine/Render/Objects/PuppetPose.cpp b/src/WallpaperEngine/Render/Objects/PuppetPose.cpp
new file mode 100644
index 00000000..db220d07
--- /dev/null
+++ b/src/WallpaperEngine/Render/Objects/PuppetPose.cpp
@@ -0,0 +1,170 @@
+#include "PuppetPose.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <glm/glm.hpp>
+#include <glm/gtc/matrix_transform.hpp>
+
+using namespace WallpaperEngine::Render::Objects;
+using namespace WallpaperEngine::Data::Model;
+
+namespace {
+constexpr float kTwoPi = 6.28318530718f;
+
+PuppetKeyframe lerp (const PuppetKeyframe& from, const PuppetKeyframe& to, float amount) {
+    return { .position = from.position + (to.position - from.position) * amount,
+	     .angles = from.angles + (to.angles - from.angles) * amount,
+	     .scale = from.scale + (to.scale - from.scale) * amount };
+}
+
+/**
+ * Bind transforms only translate, rotate around z and scale (puppets are 2D), so they can be blended as keyframes.
+ * The inverse of toMatrix for those transforms: a reflection comes back as a negative x scale and the angle in
+ * [-pi, pi]
+ */
+PuppetKeyframe fromMatrix (const glm::mat4& matrix) {
+    const glm::vec3 x (matrix[0]);
+    const float reflection = glm::determinant (glm::mat3 (matrix)) < 0.0f ? -1.0f : 1.0f;
+    return { .position = glm::vec3 (matrix[3]),
+	     .angles = { 0.0f, 0.0f, -std::atan2 (x.y * reflection, x.x * reflection) },
+	     .scale = { glm::length (x) * reflection, glm::length (glm::vec3 (matrix[1])),
+			glm::length (glm::vec3 (matrix[2])) } };
+}
+
+/**
+ * Blends two poses of a bone. The same transform can be written in several ways (a reflection on x or on y plus
+ * half a turn, angles that differ in whole turns), so 2D keyframes are first written the same way and the target
+ * angles moved to the turn closest to the current ones; otherwise blending two equal poses could rotate or
+ * collapse the bone. Keyframes that rotate around x or y are blended as authored
+ */
+PuppetKeyframe blend (const PuppetKeyframe& from, const PuppetKeyframe& to, float amount) {
+    if (amount >= 1.0f) {
+	return to;
+    }
+
+    const auto canonical = [] (const PuppetKeyframe& keyframe) {
+	return keyframe.angles.x == 0.0f && keyframe.angles.y == 0.0f ? fromMatrix (PuppetPose::toMatrix (keyframe))
+								      : keyframe;
+    };
+    const PuppetKeyframe current = canonical (from);
+    PuppetKeyframe target = canonical (to);
+    for (int axis = 0; axis < 3; axis++) {
+	target.angles[axis] += kTwoPi * std::round ((current.angles[axis] - target.angles[axis]) / kTwoPi);
+    }
+
+    return lerp (current, target, amount);
+}
+} // namespace
+
+PuppetKeyframe PuppetPose::sample (const PuppetAnimation& animation, size_t bone, double time) {
+    const auto& track = animation.tracks.at (bone);
+    if (track.size () < 2) {
+	return track.empty () ? PuppetKeyframe { .position = {}, .angles = {}, .scale = glm::vec3 (1.0f) } : track[0];
+    }
+
+    // an animation of N frames stores N + 1 keyframes when the last one closes the cycle, or just N
+    const size_t frames = track.size ();
+    const bool closed = animation.length <= 0 || frames != static_cast<size_t> (animation.length);
+    const double last = static_cast<double> (frames - 1);
+    const double frame = std::max (0.0, time * animation.fps);
+    double position = 0.0;
+
+    switch (animation.mode) {
+	case PuppetPlayMode_Single:
+	    position = std::min (frame, last);
+	    break;
+	case PuppetPlayMode_Mirror:
+	    {
+		position = std::fmod (frame, last * 2.0);
+		if (position > last) {
+		    position = last * 2.0 - position;
+		}
+		break;
+	    }
+	case PuppetPlayMode_Loop:
+	default:
+	    // without the closing keyframe the last one blends back into the first
+	    position = std::fmod (frame, closed ? last : static_cast<double> (frames));
+	    break;
+    }
+
+    const auto index = std::min (static_cast<size_t> (std::floor (position)), frames - 1);
+    size_t nextIndex = index + 1;
+    if (nextIndex >= frames) {
+	nextIndex = closed || animation.mode != PuppetPlayMode_Loop ? frames - 1 : 0;
+    }
+    return lerp (track[index], track[nextIndex], static_cast<float> (position - static_cast<double> (index)));
+}
+
+glm::mat4 PuppetPose::toMatrix (const PuppetKeyframe& keyframe) {
+    // positions are in the mesh's space (y up) but angles are authored with y pointing down, which flips the
+    // direction of the rotations around x and z
+    glm::mat4 result = glm::translate (glm::mat4 (1.0f), keyframe.position);
+    result = glm::rotate (result, -keyframe.angles.z, glm::vec3 (0.0f, 0.0f, 1.0f));
+    result = glm::rotate (result, keyframe.angles.y, glm::vec3 (0.0f, 1.0f, 0.0f));
+    result = glm::rotate (result, -keyframe.angles.x, glm::vec3 (1.0f, 0.0f, 0.0f));
+    return glm::scale (result, keyframe.scale);
+}
+
+std::vector<glm::mat4> PuppetPose::skinningMatrices (const Puppet& puppet, const std::vector<LayerState>& layers) {
+    const size_t boneCount = puppet.bones.size ();
+    std::vector<glm::mat4> result (boneCount, glm::mat4 (1.0f));
+
+    std::vector<const LayerState*> active;
+    for (const auto& layer : layers) {
+	if (layer.animation != nullptr && layer.animation->tracks.size () == boneCount && layer.blend > 0.0f) {
+	    active.push_back (&layer);
+	}
+    }
+    if (active.empty ()) {
+	return result;
+    }
+
+    std::vector<glm::mat4> bindWorld (boneCount);
+    std::vector<glm::mat4> poseWorld (boneCount);
+    for (size_t index = 0; index < boneCount; index++) {
+	const auto& bone = puppet.bones[index];
+
+	PuppetKeyframe local = fromMatrix (bone.transform);
+	for (const auto* layer : active) {
+	    local = blend (local, sample (*layer->animation, index, layer->time), layer->blend);
+	}
+
+	// the parser guarantees parents come before their children
+	const glm::mat4 poseLocal = toMatrix (local);
+	if (bone.parent < 0) {
+	    bindWorld[index] = bone.transform;
+	    poseWorld[index] = poseLocal;
+	} else {
+	    bindWorld[index] = bindWorld[bone.parent] * bone.transform;
+	    poseWorld[index] = poseWorld[bone.parent] * poseLocal;
+	}
+
+	result[index] = poseWorld[index] * glm::inverse (bindWorld[index]);
+    }
+
+    return result;
+}
+
+void PuppetPose::apply (const Puppet& puppet, const std::vector<glm::mat4>& skinning, std::vector<glm::vec3>& out) {
+    out.resize (puppet.vertices.size ());
+
+    for (size_t index = 0; index < puppet.vertices.size (); index++) {
+	const auto& vertex = puppet.vertices[index];
+	glm::vec4 position (0.0f);
+	float totalWeight = 0.0f;
+
+	for (int influence = 0; influence < 4; influence++) {
+	    const float weight = vertex.weights[influence];
+	    const uint32_t bone = vertex.bones[influence];
+	    if (weight <= 0.0f || bone >= skinning.size ()) {
+		continue;
+	    }
+	    position += skinning[bone] * glm::vec4 (vertex.position, 1.0f) * weight;
+	    totalWeight += weight;
+	}
+
+	out[index] = totalWeight > 0.0f ? glm::vec3 (position) / totalWeight : vertex.position;
+    }
+}
diff --git a/src/WallpaperEngine/Render/Objects/PuppetPose.h b/src/WallpaperEngine/Render/Objects/PuppetPose.h
new file mode 100644
index 00000000..bf5cf098
--- /dev/null
+++ b/src/WallpaperEngine/Render/Objects/PuppetPose.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <vector>
+
+#include <glm/mat4x4.hpp>
+#include <glm/vec3.hpp>
+
+#include "WallpaperEngine/Data/Model/Puppet.h"
+
+namespace WallpaperEngine::Render::Objects::PuppetPose {
+using namespace WallpaperEngine::Data::Model;
+
+/**
+ * One animation playing on a puppet, as the scene's animation layers describe it
+ */
+struct LayerState {
+    const PuppetAnimation* animation;
+    /** Seconds since the animation started, already scaled by the layer's rate */
+    double time;
+    /** How much this layer replaces the result of the previous ones (0 to 1) */
+    float blend;
+};
+
+/**
+ * @return The (interpolated) local transform of a bone at the given time, following the animation's play mode
+ */
+PuppetKeyframe sample (const PuppetAnimation& animation, size_t bone, double time);
+
+/**
+ * @return The transform matrix for a keyframe (translation * rotation * scale)
+ */
+glm::mat4 toMatrix (const PuppetKeyframe& keyframe);
+
+/**
+ * @return One matrix per bone that moves a vertex from the bind pose to the animated pose. Bones that no layer
+ * animates keep their bind pose (identity matrix)
+ */
+std::vector<glm::mat4> skinningMatrices (const Puppet& puppet, const std::vector<LayerState>& layers);
+
+/**
+ * Applies the skinning matrices to every vertex of the puppet
+ *
+ * @param out Receives the posed position of every vertex (in the model's own space)
+ */
+void apply (const Puppet& puppet, const std::vector<glm::mat4>& skinning, std::vector<glm::vec3>& out);
+} // namespace WallpaperEngine::Render::Objects::PuppetPose
diff --git a/src/WallpaperEngine/Testing/Cases/PuppetParser.cpp b/src/WallpaperEngine/Testing/Cases/PuppetParser.cpp
new file mode 100644
index 00000000..bf3c88dd
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/PuppetParser.cpp
@@ -0,0 +1,421 @@
+#include <catch2/catch_approx.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <glm/gtc/matrix_transform.hpp>
+
+#include "WallpaperEngine/Data/Parsers/PuppetParser.h"
+#include "WallpaperEngine/Render/Objects/PuppetPose.h"
+
+using Catch::Approx;
+using WallpaperEngine::Data::Parsers::PuppetParser;
+using namespace WallpaperEngine::Data::Model;
+namespace PuppetPose = WallpaperEngine::Render::Objects::PuppetPose;
+
+namespace {
+/**
+ * Writes puppet models with the same layout Wallpaper Engine uses, so every test states exactly which bytes the
+ * parser gets
+ */
+class MdlWriter {
+public:
+    template <typename T> MdlWriter& put (T value) {
+	const auto offset = this->data.size ();
+	this->data.resize (offset + sizeof (T));
+	std::memcpy (this->data.data () + offset, &value, sizeof (T));
+	return *this;
+    }
+
+    MdlWriter& string (const std::string& value) {
+	this->data.insert (this->data.end (), value.begin (), value.end ());
+	this->data.push_back ('\0');
+	return *this;
+    }
+
+    MdlWriter& zeros (size_t count) {
+	this->data.insert (this->data.end (), count, '\0');
+	return *this;
+    }
+
+    /** Replaces the four bytes at offset (used for section end offsets known only at the end) */
+    void patch (size_t offset, uint32_t value) { std::memcpy (this->data.data () + offset, &value, sizeof (value)); }
+
+    std::vector<char> data;
+};
+
+struct TestVertex {
+    float x, y;
+    uint32_t bone;
+    float u, v;
+};
+
+constexpr uint32_t kFormat52 = 0x01800009;
+constexpr uint32_t kFormat80 = 0x0180000F;
+
+void writeMesh (
+    MdlWriter& out, uint32_t format, const std::vector<TestVertex>& vertices, const std::vector<uint16_t>& indices
+) {
+    const uint32_t stride = PuppetParser::vertexStride (format);
+    out.put<uint32_t> (static_cast<uint32_t> (vertices.size () * stride));
+    for (const auto& vertex : vertices) {
+	out.put<float> (vertex.x).put<float> (vertex.y).put<float> (0.0f);
+	if (stride == 80) {
+	    // normal and tangent
+	    out.put<float> (0.0f).put<float> (0.0f).put<float> (1.0f);
+	    out.put<float> (1.0f).put<float> (0.0f).put<float> (0.0f).put<float> (1.0f);
+	}
+	out.put<uint32_t> (vertex.bone).put<uint32_t> (0).put<uint32_t> (0).put<uint32_t> (0);
+	out.put<float> (1.0f).put<float> (0.0f).put<float> (0.0f).put<float> (0.0f);
+	out.put<float> (vertex.u).put<float> (vertex.v);
+    }
+    out.put<uint32_t> (static_cast<uint32_t> (indices.size () * sizeof (uint16_t)));
+    for (const auto index : indices) {
+	out.put<uint16_t> (index);
+    }
+}
+
+void writeBone (MdlWriter& out, int parent, float x, float y, float angle = 0.0f) {
+    const glm::mat4 transform
+	= glm::rotate (glm::translate (glm::mat4 (1.0f), { x, y, 0.0f }), angle, glm::vec3 (0.0f, 0.0f, 1.0f));
+    out.string ("").put<uint32_t> (1).put<int32_t> (parent).put<uint32_t> (64);
+    for (int column = 0; column < 4; column++) {
+	for (int row = 0; row < 4; row++) {
+	    out.put<float> (transform[column][row]);
+	}
+    }
+    out.string ("");
+}
+
+void writeAnimation (
+    MdlWriter& out, int id, const std::string& mode, float fps, const std::vector<std::vector<PuppetKeyframe>>& tracks,
+    bool emptyNamePrefix = false
+) {
+    out.put<int32_t> (id).put<int32_t> (0);
+    if (emptyNamePrefix) {
+	out.string ("");
+    }
+    out.string ("Animation 1").string (mode);
+    out.put<float> (fps).put<int32_t> (static_cast<int32_t> (tracks.front ().size () - 1)).put<int32_t> (0);
+    out.put<uint32_t> (static_cast<uint32_t> (tracks.size ()));
+    for (const auto& track : tracks) {
+	out.put<int32_t> (0).put<uint32_t> (static_cast<uint32_t> (track.size () * 36));
+	for (const auto& keyframe : track) {
+	    for (int component = 0; component < 3; component++) {
+		out.put<float> (keyframe.position[component]);
+	    }
+	    for (int component = 0; component < 3; component++) {
+		out.put<float> (keyframe.angles[component]);
+	    }
+	    for (int component = 0; component < 3; component++) {
+		out.put<float> (keyframe.scale[component]);
+	    }
+	}
+    }
+}
+
+PuppetKeyframe at (float x, float y, float angle = 0.0f) {
+    return { .position = { x, y, 0.0f }, .angles = { 0.0f, 0.0f, angle }, .scale = glm::vec3 (1.0f) };
+}
+
+/**
+ * A two piece puppet laid out like a sprite sheet: the head (bone 1) is stored far to the right and only the
+ * animation puts it on top of the body, which is what SPY x FAMILY (MDLV0014) does
+ */
+std::vector<char> sheetPuppet (
+    const std::string& version, uint32_t format, bool newerHeader, size_t paddingBetweenSections,
+    const std::string& animationVersion = "MDLA0002"
+) {
+    MdlWriter out;
+    out.string (version).put<uint32_t> (format).put<uint32_t> (1).put<uint32_t> (1).string ("materials/test.json");
+    out.put<uint32_t> (0);
+    if (newerHeader) {
+	// newer versions put more data before the vertices and repeat the vertex format right before them
+	out.put<uint32_t> (0).put<uint32_t> (7).put<uint32_t> (0).put<uint32_t> (format);
+    }
+    writeMesh (
+	out, format,
+	{ { -10.0f, 0.0f, 0, 0.1f, 0.5f },
+	  { 10.0f, 0.0f, 0, 0.2f, 0.5f },
+	  { 0.0f, 20.0f, 0, 0.15f, 0.2f },
+	  { 1000.0f, 0.0f, 1, 0.8f, 0.5f },
+	  { 1010.0f, 0.0f, 1, 0.9f, 0.5f },
+	  { 1005.0f, 10.0f, 1, 0.85f, 0.4f } },
+	{ 0, 1, 2, 3, 4, 5 }
+    );
+
+    const size_t skeleton = out.data.size ();
+    out.string ("MDLS0002");
+    out.put<uint32_t> (0).put<uint16_t> (2).put<uint16_t> (0);
+    writeBone (out, -1, 0.0f, 0.0f);
+    writeBone (out, 0, 1000.0f, 0.0f);
+    out.zeros (paddingBetweenSections);
+    out.patch (skeleton + 9, static_cast<uint32_t> (out.data.size ()));
+
+    const size_t animations = out.data.size ();
+    out.string (animationVersion).put<uint32_t> (0).put<uint32_t> (2);
+    writeAnimation (out, 250, "single", 30.0f, { { at (0, 0), at (0, 0) }, { at (0, 30), at (0, 30) } });
+    // events of the first animation and padding before the next one
+    out.put<uint32_t> (1)
+	.put<float> (1.0f)
+	.string ("{\"frame\":1,\"name\":\"event\"}")
+	.zeros (paddingBetweenSections + 1);
+    writeAnimation (
+	out, 251, "loop", 10.0f, { { at (0, 0), at (0, 0), at (0, 0) }, { at (0, 30), at (0, 40), at (0, 30) } }
+    );
+    out.zeros (5);
+    out.patch (animations + 9, static_cast<uint32_t> (out.data.size ()));
+
+    return out.data;
+}
+} // namespace
+
+TEST_CASE ("Vertex size comes from the vertex format descriptor") {
+    CHECK (PuppetParser::vertexStride (kFormat52) == 52);
+    CHECK (PuppetParser::vertexStride (kFormat80) == 80);
+}
+
+TEST_CASE ("MDLV0013/0014 puppets are read with their skeleton and animations") {
+    const auto puppet = PuppetParser::parse (sheetPuppet ("MDLV0014", kFormat52, false, 0), { 250, 251 });
+
+    CHECK (puppet->version == 14);
+    CHECK (puppet->vertexStride == 52);
+    REQUIRE (puppet->vertices.size () == 6);
+    CHECK (puppet->vertices[3].position.x == Approx (1000.0f));
+    CHECK (puppet->vertices[3].bones[0] == 1);
+    CHECK (puppet->vertices[3].weights[0] == Approx (1.0f));
+    CHECK (puppet->vertices[3].texcoord.x == Approx (0.8f));
+    CHECK (puppet->indices == std::vector<uint16_t> { 0, 1, 2, 3, 4, 5 });
+
+    REQUIRE (puppet->bones.size () == 2);
+    CHECK (puppet->bones[0].parent == -1);
+    CHECK (puppet->bones[1].parent == 0);
+    CHECK (puppet->bones[1].transform[3].x == Approx (1000.0f));
+
+    REQUIRE (puppet->animations.size () == 2);
+    CHECK (puppet->animations[0].id == 250);
+    CHECK (puppet->animations[0].mode == PuppetPlayMode_Single);
+    CHECK (puppet->animations[1].id == 251);
+    CHECK (puppet->animations[1].mode == PuppetPlayMode_Loop);
+    REQUIRE (puppet->animations[1].tracks.size () == 2);
+    CHECK (puppet->animations[1].tracks[1][1].position.y == Approx (40.0f));
+}
+
+TEST_CASE ("Newer puppets (80 byte vertices, extra header fields, padding) are read from their layout") {
+    for (const char* version : { "MDLV0017", "MDLV0019", "MDLV0021", "MDLV0023", "MDLV0099" }) {
+	const auto puppet = PuppetParser::parse (sheetPuppet (version, kFormat80, true, 3, "MDLA0006"));
+
+	CAPTURE (version);
+	CHECK (puppet->vertexStride == 80);
+	REQUIRE (puppet->vertices.size () == 6);
+	CHECK (puppet->vertices[5].position.x == Approx (1005.0f));
+	CHECK (puppet->vertices[5].texcoord.y == Approx (0.4f));
+	CHECK (puppet->bones.size () == 2);
+	REQUIRE (puppet->animations.size () == 2);
+	CHECK (puppet->animations[1].id == 251);
+    }
+}
+
+TEST_CASE ("Files that are not puppets or whose mesh is broken are rejected") {
