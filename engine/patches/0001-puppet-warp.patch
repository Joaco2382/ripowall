+#pragma once
+
+#include <vector>
+
+#include "WallpaperEngine/Data/Model/Puppet.h"
+
+namespace WallpaperEngine::Data::Parsers {
+using namespace WallpaperEngine::Data::Model;
+
+/**
+ * Reads puppet warp models (.mdl files) of any MDLV version.
+ *
+ * The file is a sequence of sections:
+ *   - MDLV: vertex format descriptor, material and the mesh (vertex block followed by a triangle index block)
+ *   - MDLS: the skeleton, one bind transform (relative to the parent bone) per bone
+ *   - MDAT (optional): attachments
+ *   - MDLA: animations, one track of keyframes per bone
+ *
+ * Newer versions add fields between the material and the mesh, between animations and at the end of every
+ * section, so the mesh and the animations are located by validating their whole layout instead of trusting a
+ * fixed offset per version.
+ */
+class PuppetParser {
+public:
+    /**
+     * @param data The whole .mdl file
+     * @param animationIds The animations the scene uses (its animation layers), to tell apart layouts that read
+     * the same bytes in two ways
+     *
+     * @return The parsed puppet. If the skeleton or the animations can't be read they are left empty (and the
+     * problem logged) so the mesh can still be drawn in its bind pose
+     *
+     * @throws std::runtime_error when the file is not a puppet or its mesh can't be read
+     */
+    static PuppetUniquePtr parse (const std::vector<char>& data, const std::vector<int>& animationIds = {});
+
+    /**
+     * @return The size of every vertex for the given vertex format descriptor
+     */
+    static uint32_t vertexStride (uint32_t vertexFormat);
+};
+} // namespace WallpaperEngine::Data::Parsers
