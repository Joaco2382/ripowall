diff --git a/src/WallpaperEngine/Data/Model/Puppet.h b/src/WallpaperEngine/Data/Model/Puppet.h
new file mode 100644
index 00000000..b1626240
--- /dev/null
+++ b/src/WallpaperEngine/Data/Model/Puppet.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <glm/mat4x4.hpp>
+#include <glm/vec2.hpp>
+#include <glm/vec3.hpp>
+#include <glm/vec4.hpp>
+
+namespace WallpaperEngine::Data::Model {
+/**
+ * A vertex of a puppet warp mesh. Positions are in the model's own space: centered on the image and with y pointing up
+ */
+struct PuppetVertex {
+    glm::vec3 position;
+    std::array<uint32_t, 4> bones;
+    glm::vec4 weights;
+    glm::vec2 texcoord;
+};
+
+struct PuppetBone {
+    /** Index of the parent bone, -1 for root bones (always lower than this bone's index) */
+    int parent;
+    /** Bind pose transform relative to the parent bone */
+    glm::mat4 transform;
+};
+
+/**
+ * Local transform of one bone in one animation frame. Angles are in radians
+ */
+struct PuppetKeyframe {
+    glm::vec3 position;
+    glm::vec3 angles;
+    glm::vec3 scale;
+};
+
+enum PuppetPlayMode {
+    PuppetPlayMode_Loop = 0,
+    PuppetPlayMode_Mirror = 1,
+    PuppetPlayMode_Single = 2,
+};
+
+struct PuppetAnimation {
+    /** The id the scene's animation layers use to reference this animation */
+    int id;
+    std::string name;
+    PuppetPlayMode mode;
+    float fps;
+    /** Length in frames */
+    int length;
+    /** One list of keyframes per bone, in the same order as the skeleton */
+    std::vector<std::vector<PuppetKeyframe>> tracks;
+};
+
+struct Puppet {
+    /** The number in the MDLV header (13, 14, 17, 19, 21, 23...) */
+    int version;
+    /** Vertex format descriptor that follows the header */
+    uint32_t vertexFormat;
+    /** Size in bytes of every vertex in the file */
+    uint32_t vertexStride;
+    std::vector<PuppetVertex> vertices;
+    std::vector<uint16_t> indices;
+    std::vector<PuppetBone> bones;
+    std::vector<PuppetAnimation> animations;
+};
+
+using PuppetUniquePtr = std::unique_ptr<Puppet>;
+} // namespace WallpaperEngine::Data::Model
diff --git a/src/WallpaperEngine/Data/Parsers/PuppetParser.cpp b/src/WallpaperEngine/Data/Parsers/PuppetParser.cpp
new file mode 100644
index 00000000..25404588
--- /dev/null
+++ b/src/WallpaperEngine/Data/Parsers/PuppetParser.cpp
@@ -0,0 +1,477 @@
+#include "PuppetParser.h"
+
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstring>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+
+#include <glm/gtc/type_ptr.hpp>
+
+#include "WallpaperEngine/Logging/Log.h"
+
+using namespace WallpaperEngine::Data::Parsers;
+using namespace WallpaperEngine::Data::Model;
+
+namespace {
+static_assert (std::endian::native == std::endian::little, "Puppet models are little endian");
+
+constexpr size_t kMarkerSize = 9; // four letters, four digits and a null terminator
+constexpr uint32_t kIndexTriangleSize = sizeof (uint16_t) * 3;
+constexpr uint32_t kKeyframeSize = sizeof (float) * 9;
+constexpr uint32_t kBoneMatrixSize = sizeof (float) * 16;
+// sanity limits, only used to reject garbage while looking for a section
+constexpr size_t kMaxNameLength = 1024;
+constexpr float kMaxFps = 1000.0f;
+constexpr int kMaxAnimationLength = 1000000;
+
+/**
+ * Bounds checked little endian reader over the whole file
+ */
+class Cursor {
+public:
+    Cursor (const std::vector<char>& data, size_t offset) : m_data (&data), m_offset (offset) { }
+
+    [[nodiscard]] size_t offset () const { return this->m_offset; }
+    [[nodiscard]] bool has (size_t bytes) const {
+	return this->m_offset <= this->m_data->size () && bytes <= this->m_data->size () - this->m_offset;
+    }
+
+    template <typename T> T next () {
+	this->require (sizeof (T));
+	T value;
+	std::memcpy (&value, this->m_data->data () + this->m_offset, sizeof (T));
+	this->m_offset += sizeof (T);
+	return value;
+    }
+
+    std::string nextString () {
+	const size_t end = std::min (this->m_data->size (), this->m_offset + kMaxNameLength);
+	for (size_t index = this->m_offset; index < end; index++) {
+	    if ((*this->m_data)[index] == '\0') {
+		std::string result (this->m_data->data () + this->m_offset, index - this->m_offset);
+		this->m_offset = index + 1;
+		return result;
+	    }
+	}
+	throw std::runtime_error ("Unterminated string in puppet model at offset " + std::to_string (this->m_offset));
+    }
+
+    void skip (size_t bytes) {
+	this->require (bytes);
+	this->m_offset += bytes;
+    }
+
+private:
+    void require (size_t bytes) const {
+	if (!this->has (bytes)) {
+	    throw std::runtime_error (
+		"Unexpected end of puppet model reading " + std::to_string (bytes) + " bytes at offset "
+		+ std::to_string (this->m_offset)
+	    );
+	}
+    }
+
+    const std::vector<char>* m_data;
+    size_t m_offset;
+};
+
+/**
+ * @return The version number when there's a section marker (like "MDLS0002") at the given offset
+ */
+std::optional<int> readMarker (const std::vector<char>& data, size_t offset, const char* name) {
+    if (offset > data.size () || data.size () - offset < kMarkerSize) {
+	return std::nullopt;
+    }
+    if (std::memcmp (data.data () + offset, name, 4) != 0 || data[offset + 8] != '\0') {
+	return std::nullopt;
+    }
+
+    int version = 0;
+    for (size_t index = 4; index < 8; index++) {
+	const char digit = data[offset + index];
+	if (digit < '0' || digit > '9') {
+	    return std::nullopt;
+	}
+	version = version * 10 + (digit - '0');
+    }
+
+    return version;
+}
+
+std::optional<size_t> findMarker (const std::vector<char>& data, size_t from, size_t to, const char* name) {
+    for (size_t offset = from; offset < to && offset < data.size (); offset++) {
+	if (readMarker (data, offset, name).has_value ()) {
+	    return offset;
+	}
+    }
+    return std::nullopt;
+}
+
+bool onlyZerosFrom (const std::vector<char>& data, size_t offset) {
+    for (size_t index = offset; index < data.size (); index++) {
+	if (data[index] != '\0') {
+	    return false;
+	}
+    }
+    return true;
+}
+
+struct MeshBlock {
+    size_t vertices;
+    uint32_t vertexBytes;
+    size_t indices;
+    uint32_t indexBytes;
+    size_t end;
+};
+
+/**
+ * Looks for a vertex block (byte length + vertices) followed by an index block (byte length + triangles) that
+ * ends right where the skeleton starts. Every index is checked against the vertex count, so a match is the mesh
+ * and not some other pair of numbers that happens to fit
+ */
+std::optional<MeshBlock>
+findMeshBlock (const std::vector<char>& data, size_t from, uint32_t stride, bool requireSkeleton) {
+    for (size_t offset = from; offset + sizeof (uint32_t) * 2 <= data.size (); offset++) {
+	Cursor cursor (data, offset);
+	const auto vertexBytes = cursor.next<uint32_t> ();
+	if (vertexBytes == 0 || vertexBytes % stride != 0 || !cursor.has (vertexBytes + sizeof (uint32_t))) {
+	    continue;
+	}
+	cursor.skip (vertexBytes);
+	const auto indexBytes = cursor.next<uint32_t> ();
+	if (indexBytes == 0 || indexBytes % kIndexTriangleSize != 0 || !cursor.has (indexBytes)) {
+	    continue;
+	}
+
+	const MeshBlock block { .vertices = offset + sizeof (uint32_t),
+				.vertexBytes = vertexBytes,
+				.indices = cursor.offset (),
+				.indexBytes = indexBytes,
+				.end = cursor.offset () + indexBytes };
+
+	if (requireSkeleton ? !readMarker (data, block.end, "MDLS").has_value () : !onlyZerosFrom (data, block.end)) {
+	    continue;
+	}
+
+	const size_t vertexCount = vertexBytes / stride;
+	bool validIndices = true;
+	for (size_t index = block.indices; index < block.end; index += sizeof (uint16_t)) {
+	    uint16_t value;
+	    std::memcpy (&value, data.data () + index, sizeof (value));
+	    if (value >= vertexCount) {
+		validIndices = false;
+		break;
+	    }
+	}
+
+	if (validIndices) {
+	    return block;
+	}
+    }
+
+    return std::nullopt;
+}
+
+PuppetPlayMode parsePlayMode (const std::string& mode, bool& valid) {
+    valid = true;
+    if (mode == "loop" || mode.empty ()) {
+	return PuppetPlayMode_Loop;
+    }
+    if (mode == "mirror") {
+	return PuppetPlayMode_Mirror;
+    }
+    if (mode == "single") {
+	return PuppetPlayMode_Single;
+    }
+
+    valid = false;
+    return PuppetPlayMode_Loop;
+}
+
+bool isPrintable (const std::string& value) {
+    for (const unsigned char c : value) {
+	if (c < 0x20 && c != '\t') {
+	    return false;
+	}
+    }
+    return true;
+}
+
+/**
+ * Tries to read an animation starting exactly at the given offset. Returns nothing unless the whole layout is
+ * consistent (positive id, known play mode, sane fps and length, one track per bone with a keyframe per frame)
+ */
+std::optional<PuppetAnimation> tryParseAnimation (
+    const std::vector<char>& data, size_t offset, size_t end, size_t boneCount, size_t& next, bool emptyNamePrefix
+) {
+    try {
+	Cursor cursor (data, offset);
+	PuppetAnimation animation {};
+	animation.id = cursor.next<int32_t> ();
+	if (animation.id <= 0) {
+	    return std::nullopt;
+	}
+	std::ignore = cursor.next<int32_t> ();
+
+	if (emptyNamePrefix && !cursor.nextString ().empty ()) {
+	    return std::nullopt;
+	}
+	animation.name = cursor.nextString ();
+	bool validMode = false;
+	animation.mode = parsePlayMode (cursor.nextString (), validMode);
+	if (!validMode || !isPrintable (animation.name)) {
+	    return std::nullopt;
+	}
+
+	animation.fps = cursor.next<float> ();
+	animation.length = cursor.next<int32_t> ();
+	if (!std::isfinite (animation.fps) || animation.fps <= 0.0f || animation.fps > kMaxFps || animation.length <= 0
+	    || animation.length > kMaxAnimationLength) {
+	    return std::nullopt;
+	}
+	std::ignore = cursor.next<int32_t> ();
+
+	const auto trackCount = cursor.next<uint32_t> ();
+	if (trackCount != boneCount) {
+	    return std::nullopt;
+	}
+
+	animation.tracks.resize (trackCount);
+	for (auto& track : animation.tracks) {
+	    std::ignore = cursor.next<int32_t> ();
+	    const auto trackBytes = cursor.next<uint32_t> ();
+	    // a track holds one keyframe per frame plus the one that closes the cycle
+	    const uint32_t keyframes = trackBytes / kKeyframeSize;
+	    if (trackBytes % kKeyframeSize != 0
+		|| (keyframes != static_cast<uint32_t> (animation.length) + 1
+		    && keyframes != static_cast<uint32_t> (animation.length))
+		|| !cursor.has (trackBytes) || cursor.offset () + trackBytes > end) {
+		return std::nullopt;
+	    }
+
+	    track.resize (trackBytes / kKeyframeSize);
+	    for (auto& keyframe : track) {
+		for (int component = 0; component < 3; component++) {
+		    keyframe.position[component] = cursor.next<float> ();
+		}
+		for (int component = 0; component < 3; component++) {
+		    keyframe.angles[component] = cursor.next<float> ();
+		}
+		for (int component = 0; component < 3; component++) {
+		    keyframe.scale[component] = cursor.next<float> ();
+		}
+	    }
+	}
+
+	next = cursor.offset ();
+	return animation;
+    } catch (const std::runtime_error&) {
+	return std::nullopt;
+    }
+}
+
+void parseSkeleton (const std::vector<char>& data, size_t offset, Puppet& puppet, size_t& sectionEnd) {
+    Cursor cursor (data, offset + kMarkerSize);
+    const auto declaredEnd = cursor.next<uint32_t> ();
+    const auto boneCount = cursor.next<uint16_t> ();
+    std::ignore = cursor.next<uint16_t> ();
+
+    std::vector<PuppetBone> bones (boneCount);
+    for (size_t index = 0; index < bones.size (); index++) {
+	auto& bone = bones[index];
+	std::ignore = cursor.nextString (); // name
+	std::ignore = cursor.next<uint32_t> ();
+	bone.parent = cursor.next<int32_t> ();
+	if (bone.parent < -1 || bone.parent >= static_cast<int> (index)) {
+	    throw std::runtime_error (
+		"Bone " + std::to_string (index) + " has an invalid parent " + std::to_string (bone.parent)
+	    );
+	}
+
+	const auto matrixBytes = cursor.next<uint32_t> ();
+	if (matrixBytes != kBoneMatrixSize) {
+	    throw std::runtime_error ("Unsupported bone matrix size " + std::to_string (matrixBytes));
+	}
+	float matrix[16];
+	for (float& value : matrix) {
+	    value = cursor.next<float> ();
+	}
+	bone.transform = glm::make_mat4 (matrix);
+	std::ignore = cursor.nextString (); // physics simulation settings (json)
+    }
+
+    puppet.bones = std::move (bones);
+    // newer skeleton versions append more data per bone, the section starts with the offset where it ends
+    sectionEnd = declaredEnd >= cursor.offset () && declaredEnd <= data.size () ? declaredEnd : cursor.offset ();
+}
+
+std::optional<PuppetAnimation> findAnimation (
+    const std::vector<char>& data, size_t from, size_t end, size_t boneCount, size_t& next, bool emptyNamePrefix
+) {
+    for (size_t candidate = from; candidate < end; candidate++) {
+	auto animation = tryParseAnimation (data, candidate, end, boneCount, next, emptyNamePrefix);
+	if (animation.has_value ()) {
+	    return animation;
+	}
+    }
+    return std::nullopt;
+}
+
+void parseAnimations (
+    const std::vector<char>& data, size_t offset, Puppet& puppet, const std::vector<int>& animationIds
+) {
+    Cursor cursor (data, offset + kMarkerSize);
+    const auto declaredEnd = cursor.next<uint32_t> ();
+    const auto animationCount = cursor.next<uint32_t> ();
+    const size_t end = declaredEnd > cursor.offset () && declaredEnd <= data.size () ? declaredEnd : data.size ();
+    const auto used = [&animationIds] (const std::optional<PuppetAnimation>& animation) {
+	return animation.has_value ()
+	    && std::find (animationIds.begin (), animationIds.end (), animation->id) != animationIds.end ();
+    };
+
+    size_t position = cursor.offset ();
+    for (uint32_t index = 0; index < animationCount; index++) {
+	// animations are separated by version dependant padding and event lists, so look for the next one. Some
+	// files put an empty string before the name, but that layout can't be told apart from the regular one read
+	// one byte off when the id's lowest byte is zero (id 512 is "00 02 00 00"), so the regular layout wins
+	// unless only the other one gives an id the scene uses
+	size_t regularNext = position;
+	size_t prefixedNext = position;
+	auto animation = findAnimation (data, position, end, puppet.bones.size (), regularNext, false);
+	auto prefixed = findAnimation (data, position, end, puppet.bones.size (), prefixedNext, true);
+	size_t next = regularNext;
+	if (!animation.has_value () || (used (prefixed) && !used (animation))) {
+	    animation = std::move (prefixed);
+	    next = prefixedNext;
+	}
+
+	if (!animation.has_value ()) {
+	    // keep the ones already read, the layers that use the missing ones stay in the bind pose
+	    sLog.error (
+		"Puppet MDLV", puppet.version, ": could not find animation ", index + 1, " of ", animationCount
+	    );
+	    return;
+	}
+
+	puppet.animations.push_back (std::move (*animation));
+	position = next;
+    }
+}
+} // namespace
+
+uint32_t PuppetParser::vertexStride (uint32_t vertexFormat) {
+    // position, 4 bone indices, 4 bone weights and texture coordinates are always there. Bits 0x2 and 0x4 add a
+    // normal and a tangent between the position and the bone data (0x01800009 -> 52 bytes, 0x0180000F -> 80 bytes)
+    uint32_t stride = sizeof (float) * 3 + sizeof (uint32_t) * 4 + sizeof (float) * 4 + sizeof (float) * 2;
+    if (vertexFormat & 0x2) {
+	stride += sizeof (float) * 3;
+    }
+    if (vertexFormat & 0x4) {
+	stride += sizeof (float) * 4;
+    }
+    return stride;
+}
+
+PuppetUniquePtr PuppetParser::parse (const std::vector<char>& data, const std::vector<int>& animationIds) {
+    const auto version = readMarker (data, 0, "MDLV");
+    if (!version.has_value ()) {
+	throw std::runtime_error ("Not a puppet model (missing MDLV header)");
+    }
+
+    auto puppet = std::make_unique<Puppet> ();
+    puppet->version = *version;
+
+    Cursor header (data, kMarkerSize);
+    puppet->vertexFormat = header.next<uint32_t> ();
+    std::ignore = header.next<uint32_t> ();
+    std::ignore = header.next<uint32_t> ();
+    std::ignore = header.nextString (); // material
+    const size_t meshSearchStart = header.offset ();
+
+    // the vertex format gives the vertex size, the known sizes are tried after it just in case
+    std::vector<uint32_t> strides = { vertexStride (puppet->vertexFormat) };
+    for (const uint32_t known : { 52u, 80u }) {
+	if (std::find (strides.begin (), strides.end (), known) == strides.end ()) {
+	    strides.push_back (known);
+	}
+    }
+
+    std::optional<MeshBlock> mesh = std::nullopt;
+    for (const bool requireSkeleton : { true, false }) {
+	for (const uint32_t stride : strides) {
+	    mesh = findMeshBlock (data, meshSearchStart, stride, requireSkeleton);
+	    if (mesh.has_value ()) {
+		puppet->vertexStride = stride;
+		break;
+	    }
+	}
+	if (mesh.has_value ()) {
+	    break;
+	}
+    }
+
+    if (!mesh.has_value ()) {
+	throw std::runtime_error (
+	    "Could not find the mesh in MDLV" + std::to_string (puppet->version) + " (vertex format "
+	    + std::to_string (puppet->vertexFormat) + ")"
+	);
+    }
+
+    const uint32_t stride = puppet->vertexStride;
+    // the bone data and texture coordinates are always the last 40 bytes of the vertex
+    const size_t bonesOffset = stride - sizeof (float) * 10;
+    const size_t weightsOffset = stride - sizeof (float) * 6;
+    const size_t texcoordOffset = stride - sizeof (float) * 2;
