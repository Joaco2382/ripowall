+TEST_CASE ("The animation moves sprite sheet pieces into place") {
+    const auto puppet = PuppetParser::parse (sheetPuppet ("MDLV0014", kFormat52, false, 0));
+    std::vector<glm::vec3> posed;
+
+    // no layer: everything stays where the file stores it
+    PuppetPose::apply (*puppet, PuppetPose::skinningMatrices (*puppet, {}), posed);
+    CHECK (posed[3].x == Approx (1000.0f));
+
+    // the layer moves bone 1 from (1000, 0) to (0, 30): the head lands on top of the body
+    const std::vector<PuppetPose::LayerState> layers
+	= { { .animation = &puppet->animations[0], .time = 0.0, .blend = 1.0f } };
+    PuppetPose::apply (*puppet, PuppetPose::skinningMatrices (*puppet, layers), posed);
+    CHECK (posed[0].x == Approx (-10.0f)); // the body doesn't move
+    CHECK (posed[3].x == Approx (0.0f));
+    CHECK (posed[3].y == Approx (30.0f));
+    CHECK (posed[5].x == Approx (5.0f));
+    CHECK (posed[5].y == Approx (40.0f));
+
+    // half blended layer: half way
+    const std::vector<PuppetPose::LayerState> half
+	= { { .animation = &puppet->animations[0], .time = 0.0, .blend = 0.5f } };
+    PuppetPose::apply (*puppet, PuppetPose::skinningMatrices (*puppet, half), posed);
+    CHECK (posed[3].x == Approx (500.0f));
+    CHECK (posed[3].y == Approx (15.0f));
+}
