+
+    CHECK (PuppetPose::sample (animation, 0, 1.0).position.x == Approx (10.0f));
+    CHECK (PuppetPose::sample (animation, 0, 1.5).position.x == Approx (5.0f));
+    CHECK (PuppetPose::sample (animation, 0, 2.0).position.x == Approx (0.0f).margin (1e-4));
+    CHECK (PuppetPose::sample (animation, 0, 2.5).position.x == Approx (5.0f));
+}
