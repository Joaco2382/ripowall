+TEST_CASE ("Blending towards the same pose leaves reflected bones in place") {
+    const glm::mat4 reflected
+	= glm::scale (glm::translate (glm::mat4 (1.0f), { 5.0f, 0.0f, 0.0f }), { -1.0f, 1.0f, 1.0f });
+    const glm::vec3 vertex (12.0f, 3.0f, 0.0f);
+
+    // the same reflected transform written as a negative x scale, and as a negative y scale plus half a turn
+    const PuppetKeyframe onX { .position = { 5.0f, 0.0f, 0.0f }, .angles = {}, .scale = { -1.0f, 1.0f, 1.0f } };
+    const PuppetKeyframe onY { .position = { 5.0f, 0.0f, 0.0f },
+			       .angles = { 0.0f, 0.0f, 3.14159265f },
+			       .scale = { 1.0f, -1.0f, 1.0f } };
+
+    for (const auto& keyframe : { onX, onY }) {
+	const auto posed = poseOne (reflected, vertex, still (keyframe), 0.5f);
+	CHECK (posed.x == Approx (12.0f).margin (1e-3));
+	CHECK (posed.y == Approx (3.0f).margin (1e-3));
+    }
+}
+
+TEST_CASE ("Blending towards the same pose ignores whole turns in the angles") {
+    const auto keyframe = at (5.0f, 0.0f, 4.0f);
+    const auto posed = poseOne (PuppetPose::toMatrix (keyframe), { 12.0f, 3.0f, 0.0f }, still (keyframe), 0.5f);
+    CHECK (posed.x == Approx (12.0f).margin (1e-3));
+    CHECK (posed.y == Approx (3.0f).margin (1e-3));
+}
