+    puppet->vertices.resize (mesh->vertexBytes / stride);
+    for (size_t index = 0; index < puppet->vertices.size (); index++) {
+	const size_t base = mesh->vertices + index * stride;
+	auto& vertex = puppet->vertices[index];
+
+	Cursor cursor (data, base);
+	for (int component = 0; component < 3; component++) {
+	    vertex.position[component] = cursor.next<float> ();
+	}
+	cursor = Cursor (data, base + bonesOffset);
+	for (auto& bone : vertex.bones) {
+	    bone = cursor.next<uint32_t> ();
+	}
+	cursor = Cursor (data, base + weightsOffset);
+	for (int component = 0; component < 4; component++) {
+	    vertex.weights[component] = cursor.next<float> ();
+	}
+	cursor = Cursor (data, base + texcoordOffset);
+	vertex.texcoord.x = cursor.next<float> ();
+	vertex.texcoord.y = cursor.next<float> ();
+    }
+
+    puppet->indices.resize (mesh->indexBytes / sizeof (uint16_t));
+    std::memcpy (puppet->indices.data (), data.data () + mesh->indices, mesh->indexBytes);
+
+    if (!readMarker (data, mesh->end, "MDLS").has_value ()) {
+	return puppet;
+    }
+
+    // skeleton and animations are optional: without them the mesh is drawn as it's stored (the bind pose)
+    try {
+	size_t skeletonEnd = mesh->end;
+	parseSkeleton (data, mesh->end, *puppet, skeletonEnd);
+
+	const auto animations = findMarker (data, skeletonEnd, data.size (), "MDLA");
+	if (animations.has_value () && !puppet->bones.empty ()) {
+	    parseAnimations (data, *animations, *puppet, animationIds);
+	}
+    } catch (const std::runtime_error& ex) {
+	sLog.error (
+	    "Puppet MDLV", puppet->version, " skeleton/animations could not be read, using the bind pose: ", ex.what ()
+	);
+	puppet->bones.clear ();
+	puppet->animations.clear ();
+    }
+
+    return puppet;
+}
