+namespace {
+/** Posed position of one vertex hanging from a single root bone */
+glm::vec3 poseOne (const glm::mat4& bind, const glm::vec3& vertex, const PuppetAnimation& animation, float blend) {
+    Puppet puppet {};
+    puppet.bones = { { .parent = -1, .transform = bind } };
+    puppet.vertices = { { .position = vertex, .bones = { 0, 0, 0, 0 }, .weights = { 1, 0, 0, 0 }, .texcoord = {} } };
+    std::vector<glm::vec3> posed;
+    PuppetPose::apply (
+	puppet, PuppetPose::skinningMatrices (puppet, { { .animation = &animation, .time = 0.0, .blend = blend } }),
+	posed
+    );
+    return posed[0];
+}
+
+PuppetAnimation still (const PuppetKeyframe& keyframe) {
+    return { .id = 1,
+	     .name = "",
+	     .mode = PuppetPlayMode_Single,
+	     .fps = 1.0f,
+	     .length = 1,
+	     .tracks = { { keyframe, keyframe } } };
+}
+} // namespace
