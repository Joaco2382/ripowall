     if (infoLogLength > 0) {
 	const auto logBuffer = new char[infoLogLength + 1];
 	// ensure logBuffer ends with a \0
@@ -962,10 +967,48 @@ template <typename T> void CPass::addUniform (const std::string& name, UniformTy
     );
 }
 
+void CPass::collectActiveUniformTypes () {
+    this->m_activeUniformTypes.clear ();
+
+    GLint count = 0;
+    GLint maxLength = 0;
+    glGetProgramiv (this->m_programID, GL_ACTIVE_UNIFORMS, &count);
+    glGetProgramiv (this->m_programID, GL_ACTIVE_UNIFORM_MAX_LENGTH, &maxLength);
+    std::vector<char> name (static_cast<size_t> (std::max (maxLength, 1)) + 1, '\0');
+
+    for (GLint index = 0; index < count; index++) {
+	GLint size = 0;
+	GLenum type = GL_NONE;
+	GLsizei length = 0;
+	glGetActiveUniform (
+	    this->m_programID, static_cast<GLuint> (index), static_cast<GLsizei> (name.size ()), &length, &size, &type,
+	    name.data ()
+	);
+	std::string uniformName (name.data (), static_cast<size_t> (length));
+	// arrays are reported as "name[0]"
+	if (const auto bracket = uniformName.find ('['); bracket != std::string::npos) {
+	    uniformName.resize (bracket);
+	}
+	this->m_activeUniformTypes.insert_or_assign (uniformName, type);
+    }
+}
+
+const ShaderVariable* CPass::pickParameter (const ShaderVariable* vertex, const ShaderVariable* fragment) const {
+    return Shaders::pickDeclaration (vertex, fragment, this->m_activeUniformTypes);
+}
+
 void CPass::setupShaderVariables () {
     for (const auto& cur : this->m_shader->getVertex ().getParameters ()) {
 	if (!this->m_uniforms.contains (cur->getName ())) {
-	    this->addUniform (cur);
+	    const ShaderVariable* fragment = nullptr;
+	    for (const auto& candidate : this->m_shader->getFragment ().getParameters ()) {
+		if (candidate->getName () == cur->getName ()) {
+		    fragment = candidate;
+		    break;
+		}
+	    }
+	    const ShaderVariable* variable = this->pickParameter (cur, fragment);
+	    this->addUniform (variable, variable);
 	}
     }
 
@@ -983,8 +1026,7 @@ void CPass::setupShaderVariables () {
 	    continue;
 	}
 
-	ShaderVariable* var = vertex == nullptr ? fragment : vertex;
-	this->addUniform (var, value->value.get ());
+	this->addUniform (this->pickParameter (vertex, fragment), value->value.get ());
     }
 
     // apply override constants (highest priority, overrides both defaults and pass constants)
@@ -995,8 +1037,7 @@ void CPass::setupShaderVariables () {
 	    continue;
 	}
 
-	ShaderVariable* var = vertex == nullptr ? fragment : vertex;
-	this->addUniform (var, value->value.get ());
+	this->addUniform (this->pickParameter (vertex, fragment), value->value.get ());
     }
 }
 
@@ -1008,6 +1049,31 @@ void CPass::addUniform (ShaderVariable* value) {
 }
 
 void CPass::addUniform (const ShaderVariable* value, const DynamicValue* setting) {
+    // the type the linked program uses decides how the value is sent (a mismatched glUniform call is an error)
+    if (const auto active = this->m_activeUniformTypes.find (value->getName ());
+	active != this->m_activeUniformTypes.end ()) {
+	switch (active->second) {
+	    case GL_FLOAT:
+		this->addUniform (value->getName (), &setting->getFloat ());
+		return;
+	    case GL_INT:
+	    case GL_BOOL:
+		this->addUniform (value->getName (), &setting->getInt ());
+		return;
+	    case GL_FLOAT_VEC2:
+		this->addUniform (value->getName (), &setting->getVec2 ());
+		return;
+	    case GL_FLOAT_VEC3:
+		this->addUniform (value->getName (), &setting->getVec3 ());
+		return;
+	    case GL_FLOAT_VEC4:
+		this->addUniform (value->getName (), &setting->getVec4 ());
+		return;
+	    default:
+		break;
+	}
+    }
+
     if (value->is<ShaderVariableFloat> ()) {
 	this->addUniform (value->getName (), &setting->getFloat ());
     } else if (value->is<ShaderVariableInteger> ()) {
