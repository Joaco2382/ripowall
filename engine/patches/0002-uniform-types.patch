diff --git a/src/WallpaperEngine/Render/Shaders/UniformTypes.cpp b/src/WallpaperEngine/Render/Shaders/UniformTypes.cpp
new file mode 100644
index 00000000..2abb41a0
--- /dev/null
+++ b/src/WallpaperEngine/Render/Shaders/UniformTypes.cpp
@@ -0,0 +1,43 @@
+#include "UniformTypes.h"
+
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableFloat.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableInteger.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableVector2.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableVector3.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableVector4.h"
+
+using namespace WallpaperEngine::Render::Shaders;
+using namespace WallpaperEngine::Render::Shaders::Variables;
+
+bool WallpaperEngine::Render::Shaders::matchesUniformType (const ShaderVariable& variable, GLenum type) {
+    switch (type) {
+	case GL_FLOAT:
+	    return variable.is<ShaderVariableFloat> ();
+	case GL_INT:
+	case GL_BOOL:
+	    return variable.is<ShaderVariableInteger> ();
+	case GL_FLOAT_VEC2:
+	    return variable.is<ShaderVariableVector2> ();
+	case GL_FLOAT_VEC3:
+	    return variable.is<ShaderVariableVector3> ();
+	case GL_FLOAT_VEC4:
+	    return variable.is<ShaderVariableVector4> ();
+	default:
+	    return false;
+    }
+}
+
+const ShaderVariable* WallpaperEngine::Render::Shaders::pickDeclaration (
+    const ShaderVariable* vertex, const ShaderVariable* fragment, const ActiveUniformTypes& activeTypes
+) {
+    if (vertex == nullptr || fragment == nullptr) {
+	return vertex != nullptr ? vertex : fragment;
+    }
+
+    const auto type = activeTypes.find (vertex->getName ());
+    if (type != activeTypes.end () && !matchesUniformType (*vertex, type->second)
+	&& matchesUniformType (*fragment, type->second)) {
+	return fragment;
+    }
+    return vertex;
+}
diff --git a/src/WallpaperEngine/Render/Shaders/UniformTypes.h b/src/WallpaperEngine/Render/Shaders/UniformTypes.h
new file mode 100644
index 00000000..64ddc562
--- /dev/null
+++ b/src/WallpaperEngine/Render/Shaders/UniformTypes.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <map>
+#include <string>
+
+#include <GL/glew.h>
+
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariable.h"
+
+namespace WallpaperEngine::Render::Shaders {
+/**
+ * Type of every active uniform of a linked program, as OpenGL reports it (glGetActiveUniform)
+ */
+using ActiveUniformTypes = std::map<std::string, GLenum>;
+
+/**
+ * @return Whether a uniform declaration parsed from the shader source has the type the linked program uses
+ */
+bool matchesUniformType (const Variables::ShaderVariable& variable, GLenum type);
+
+/**
+ * The uniform parser doesn't evaluate #if blocks, so the same name can be declared with one type in an inactive
+ * branch of one stage and with another type in the other stage. Picks the declaration that matches the linked
+ * program, the vertex one when both (or none) match
+ */
+const Variables::ShaderVariable* pickDeclaration (
+    const Variables::ShaderVariable* vertex, const Variables::ShaderVariable* fragment,
+    const ActiveUniformTypes& activeTypes
+);
+} // namespace WallpaperEngine::Render::Shaders
diff --git a/src/WallpaperEngine/Testing/Cases/UniformTypes.cpp b/src/WallpaperEngine/Testing/Cases/UniformTypes.cpp
new file mode 100644
index 00000000..421896b4
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/UniformTypes.cpp
@@ -0,0 +1,40 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "WallpaperEngine/Render/Shaders/UniformTypes.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableFloat.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableVector2.h"
+#include "WallpaperEngine/Render/Shaders/Variables/ShaderVariableVector4.h"
+
+using namespace WallpaperEngine::Render::Shaders;
+using namespace WallpaperEngine::Render::Shaders::Variables;
+
+// clouds.vert declares "uniform vec2 g_CloudSpeeds" inside #if PERSPECTIVE == 0 and clouds.frag declares
+// "uniform vec4 g_CloudSpeeds" inside #else: with PERSPECTIVE = 1 only the vec4 one exists in the program
+TEST_CASE ("The declaration that matches the linked program wins over an inactive one") {
+    const ShaderVariableVector2 vertex ({ 0.01f, -0.02f }, "g_CloudSpeeds");
+    const ShaderVariableVector4 fragment ({ 0.01f, 0.01f, -0.02f, -0.02f }, "g_CloudSpeeds");
+
+    CHECK (pickDeclaration (&vertex, &fragment, { { "g_CloudSpeeds", GL_FLOAT_VEC4 } }) == &fragment);
+    CHECK (pickDeclaration (&vertex, &fragment, { { "g_CloudSpeeds", GL_FLOAT_VEC2 } }) == &vertex);
+}
+
+TEST_CASE ("Without a conflict the declaration found is used") {
+    const ShaderVariableFloat vertex (1.0f, "g_Speed");
+    const ShaderVariableFloat fragment (2.0f, "g_Speed");
+
+    CHECK (pickDeclaration (&vertex, nullptr, { { "g_Speed", GL_FLOAT_VEC4 } }) == &vertex);
+    CHECK (pickDeclaration (nullptr, &fragment, {}) == &fragment);
+    // both match (or the program doesn't use it): the vertex one, as before
+    CHECK (pickDeclaration (&vertex, &fragment, { { "g_Speed", GL_FLOAT } }) == &vertex);
+    CHECK (pickDeclaration (&vertex, &fragment, {}) == &vertex);
+}
+
+TEST_CASE ("Uniform types are matched by their OpenGL type") {
+    const ShaderVariableVector2 vector2 ({ 0.0f, 0.0f }, "a");
+    const ShaderVariableFloat number (0.0f, "b");
+
+    CHECK (matchesUniformType (vector2, GL_FLOAT_VEC2));
+    CHECK_FALSE (matchesUniformType (vector2, GL_FLOAT_VEC4));
+    CHECK (matchesUniformType (number, GL_FLOAT));
+    CHECK_FALSE (matchesUniformType (number, GL_INT));
+}
