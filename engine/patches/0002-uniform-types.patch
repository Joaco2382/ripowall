@@ -645,6 +646,10 @@ void CPass::setupShaders () {
     glGetProgramiv (this->m_programID, GL_LINK_STATUS, &result);
     glGetProgramiv (this->m_programID, GL_INFO_LOG_LENGTH, &infoLogLength);
 
+    if (result == GL_TRUE) {
